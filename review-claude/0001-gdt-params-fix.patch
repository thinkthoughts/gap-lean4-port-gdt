diff --git a/gdt-readingpoint/GDTReadingPoint/Basic.lean b/gdt-readingpoint/GDTReadingPoint/Basic.lean
index 5ba3e7e..b1d1512 100644
--- a/gdt-readingpoint/GDTReadingPoint/Basic.lean
+++ b/gdt-readingpoint/GDTReadingPoint/Basic.lean
@@ -5,21 +5,18 @@ Input parameters for the General Divisor Theorem reading point.
 
 The positivity hypotheses follow the mathematical specification:
 `N > 0` and `m > 0`.
+
+The fields are written `Nat` (not `ℕ`): this file imports nothing, so the
+Mathlib notation `ℕ` is unavailable here, and with `autoImplicit` it would be
+silently auto-bound as a type variable, making `Params` uninhabited.
 -/
 structure Params where
-  N : ℕ
-  m : ℕ
-  a : ℕ
+  N : Nat
+  m : Nat
+  a : Nat
   hN : 0 < N
   hm : 0 < m
 
--- Planned GDT quantities:
---
--- d     = rad(gcd(m,N))
--- R     = rad(N) / d
--- Tmin  = m * R
---
--- We add these only after confirming the exact radical API
--- available in the host Mathlib version.
+-- The GDT quantities `d`, `R`, `Tmin` are defined in `Parameters.lean`.
 
 end GDTReadingPoint
diff --git a/gdt-readingpoint/GDTReadingPoint/Examples.lean b/gdt-readingpoint/GDTReadingPoint/Examples.lean
index 18f3934..4110612 100644
--- a/gdt-readingpoint/GDTReadingPoint/Examples.lean
+++ b/gdt-readingpoint/GDTReadingPoint/Examples.lean
@@ -2,16 +2,22 @@ import GDTReadingPoint.Admissible
 
 namespace GDTReadingPoint
 
+/--
+Regression guard: `Params` must be inhabited. If a field type is ever
+auto-bound (e.g. `ℕ` without its notation in scope), this stops compiling.
+-/
+example : Params := ⟨18, 2, 1, by decide, by decide⟩
+
 /--
 A minimal arithmetic reading point: residue `1` is admissible modulo `30`.
 -/
 example : Admissible 1 30 := by
-  decide
+  unfold Admissible; decide
 
 /--
 A non-admissible arithmetic reading point: residue `3` is not coprime to `30`.
 -/
 example : NonAdmissible 3 30 := by
-  decide
+  unfold NonAdmissible Admissible; decide
 
 end GDTReadingPoint
